struct source { vec3 position; vec3 direction; };
struct sphere { vec3 position; float radius; };
struct contact { sphere object; float intersection; };

// ---------------------------------------------------------------
// Intersección rayo-esfera
// ---------------------------------------------------------------

float getSphereIntersection(const in source ray, const in sphere s, const in float tMin, const in float tMax)
{
    vec3 oc = ray.position - s.position;

    float a = dot(ray.direction, ray.direction);
    float b = 2.0 * dot(oc, ray.direction);
    float c = dot(oc, oc) - s.radius * s.radius;

    float d = b * b - 4.0 * a * c;

    if(d < 0.0) return InvalidIntersection;

    float r = sqrt(d);

    float t0 = (-b - r) / (2.0 * a);
    float t1 = (-b + r) / (2.0 * a);

    if(t0 > tMin && t0 < tMax) return t0;
    if(t1 > tMin && t1 < tMax) return t1;

    return InvalidIntersection;
}

void testSphere(const in source ray, const in sphere s, inout contact hit)
{
    float t = getSphereIntersection(ray, s, RayMin, RayMax);

    if(t != InvalidIntersection && t < hit.intersection) hit = contact(s, t);
}

contact createContact()
{
    contact hit;

    hit.intersection = RayMax;
    hit.object.position = vec3(0.0);
    hit.object.radius = 0.0;

    return hit;
}

contact trace(const in source ray)
{
    contact hit = createContact();

    for(int i = 0; i < SPHERE_COUNT; i++)
    {
        vec4 sd = spheres[i];
        testSphere(ray, sphere(sd.xyz, sd.w), hit);
    }

    return hit;
}

// ---------------------------------------------------------------
// Ambient Occlusion analítico esfera-esfera (Inigo Quilez)
// ---------------------------------------------------------------

float sphOcclusion(vec3 pos, vec3 nor, vec4 sph)
{
    vec3  di = sph.xyz - pos;
    float l  = length(di);
    float nl = dot(nor, di / l);
    float h  = l / sph.w;
    float h2 = h * h;
    float k2 = 1.0 - h2 * nl * nl;

    float res = max(0.0, nl) / h2;
    if(k2 > 0.0) // aproximacion para penetracion
    {
        res = clamp(0.5 * (nl * h + 1.0) / h2, 0.0, 1.0);
        res = sqrt(res * res * res);
    }
    return res;
}

// self: la esfera que generó el punto p, para no autoocluirse
float computeAO(const in vec3 p, const in vec3 n, const in sphere self)
{
    float occlusion = 0.0;

    for(int i = 0; i < SPHERE_COUNT; i++)
    {
        vec4 sd = spheres[i];

        // salta la propia esfera impactada (misma posicion+radio)
        if(sd.xyz == self.position && sd.w == self.radius) continue;

        occlusion += sphOcclusion(p, n, sd);
    }

    return clamp(1.0 - occlusion, 0.0, 1.0);
}

// ---------------------------------------------------------------
// Shading
// ---------------------------------------------------------------

vec3 getSphereAppearance(const in source ray, const in sphere s, const in float t)
{
    vec3 p = ray.position + t * ray.direction;
    vec3 n = normalize(p - s.position);

    vec3 view = normalize(ray.position - p);

    float light = max(0.0, 0.5 + 0.5 * dot(view, n));
    float ao = computeAO(p, n, s);

    vec3 a = abs(n);
    float m = max(a.x, max(a.y, a.z));
    vec3 color = step(vec3(m), a);

    return light * ao * color;
}

void traceRay(inout vec3 color, const in source ray)
{
    contact hit = trace(ray);

    if(hit.intersection <= RayMin || hit.intersection >= RayMax) return;

    color = getSphereAppearance(ray, hit.object, hit.intersection);
}

// ---------------------------------------------------------------
// Camara / entrada principal (Shadertoy)
// ---------------------------------------------------------------

void mainImage(out vec4 fragmentColor, in vec2 fragmentPosition)
{
    fragmentColor = vec4(0.0, 0.0, 0.0, 1.0);

    const vec3 target = vec3(0.0);

    float longitude = radians(45.0 + 45.0 * iTime);
    float latitude  = radians(45.0 + 45.0 * sin(iTime));
    float distance  = 500.0;

    vec3 cameraPosition;
    cameraPosition.x = distance * cos(latitude) * cos(longitude);
    cameraPosition.y = distance * sin(latitude);
    cameraPosition.z = distance * cos(latitude) * sin(longitude);

    vec3 forward = normalize(target - cameraPosition);
    vec3 right   = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
    vec3 up      = cross(right, forward);

    vec2 uv = (fragmentPosition - 0.5 * iResolution.xy) / iResolution.y;

    source ray;
    ray.position  = cameraPosition;
    ray.direction = normalize(forward + uv.x * right + uv.y * up);

    vec3 color = vec3(0.0);
    traceRay(color, ray);

    fragmentColor = vec4(color, 1.0);
}
