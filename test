const float InvalidIntersection = 3.4028235e38;

struct source
{
    vec3 position;
    vec3 direction;
};

struct sphere
{
    vec3 position;
    float radius;
};

const int SphereCount = 6;

sphere spheres[SphereCount];

float getSphereIntersection(
    const in source ray,
    const in sphere s,
    const in float tMin,
    const in float tMax)
{
    vec3 oc = ray.position - s.position;

    float a = dot(ray.direction, ray.direction);
    float b = 2.0 * dot(oc, ray.direction);
    float c = dot(oc, oc) - s.radius * s.radius;

    float d = b * b - 4.0 * a * c;

    if (d < 0.0)
        return InvalidIntersection;

    float r = sqrt(d);

    float t0 = (-b - r) / (2.0 * a);
    float t1 = (-b + r) / (2.0 * a);

    if (t0 > tMin && t0 < tMax)
        return t0;

    if (t1 > tMin && t1 < tMax)
        return t1;

    return InvalidIntersection;
}

vec3 getSphereAppearance(
    const in source ray,
    const in sphere s,
    const in float t)
{
    vec3 p = ray.position + t * ray.direction;
    vec3 n = normalize(p - s.position);

    vec3 view = normalize(ray.position - p);

    float light = max(0.0, 0.5 + 0.5 * dot(view, n));

    vec3 a = abs(n);

    float m = max(a.x, max(a.y, a.z));

    vec3 color = step(vec3(m), a);

    return light * color;
}

vec3 traceRay(source ray)
{
    float closest = InvalidIntersection;
    int hit = -1;

    for(int i = 0; i < SphereCount; i++)
    {
        float t = getSphereIntersection(
            ray,
            spheres[i],
            0.001,
            10000.0);

        if(t < closest)
        {
            closest = t;
            hit = i;
        }
    }

    if(hit >= 0)
        return getSphereAppearance(ray, spheres[hit], closest);

    return vec3(0.0);
}

void mainImage(out vec4 fragmentColor, in vec2 fragmentPosition)
{
    //------------------------------------------------------
    // Escena
    //------------------------------------------------------

    spheres[0] = sphere(vec3( 100.0, 100.0,-100.0),100.0);
    spheres[1] = sphere(vec3(-150.0,  50.0,   0.0), 75.0);
    spheres[2] = sphere(vec3(   0.0,-100.0, 150.0), 60.0);
    spheres[3] = sphere(vec3( 200.0,   0.0, 150.0), 80.0);
    spheres[4] = sphere(vec3(-200.0, 150.0,-200.0), 90.0);
    spheres[5] = sphere(vec3(   0.0, 200.0,   0.0),120.0);

    //------------------------------------------------------
    // Cámara
    //------------------------------------------------------

    const vec3 target = vec3(0.0);

    float longitude = radians(45.0 + 45.0 * iTime);
    float latitude  = radians(45.0 + 45.0 * sin(iTime));
    float distance  = 500.0;

    vec3 cameraPosition;

    cameraPosition.x = distance * cos(latitude) * cos(longitude);
    cameraPosition.y = distance * sin(latitude);
    cameraPosition.z = distance * cos(latitude) * sin(longitude);

    vec3 forward = normalize(target - cameraPosition);
    vec3 right   = normalize(cross(vec3(0.0,1.0,0.0), forward));
    vec3 up      = cross(forward, right);

    mat3 camera = mat3(right, up, forward);

    float fov = 60.0;
    float focal = 1.0 / tan(radians(fov * 0.5));

    //------------------------------------------------------
    // 4x MSAA
    //------------------------------------------------------

    vec2 offsets[4];

    offsets[0] = vec2(-0.25,-0.25);
    offsets[1] = vec2( 0.25,-0.25);
    offsets[2] = vec2(-0.25, 0.25);
    offsets[3] = vec2( 0.25, 0.25);

    vec3 color = vec3(0.0);

    for(int sample1 = 0; sample1 < 4; sample1++)
    {
        vec2 uv =
            (2.0 * (fragmentPosition + offsets[sample1]) - iResolution.xy)
            / min(iResolution.x, iResolution.y);

        vec3 direction =
            normalize(camera * vec3(uv, focal));

        source ray = source(cameraPosition, direction);

        color += traceRay(ray);
    }

    color /= 4.0;

    fragmentColor = vec4(color,1.0);
}
