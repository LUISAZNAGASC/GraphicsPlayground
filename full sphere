const float InvalidIntersection = 3.4028235e38;

struct source
{
    vec3 position;
    vec3 direction;
};

struct sphere
{
    vec3 position;
    float radius;
};

struct contact
{
    sphere object;
    float intersection;
};

float getSphereIntersection(
    const in source ray,
    const in sphere s,
    const in float tMin,
    const in float tMax)
{
    vec3 oc = ray.position - s.position;

    float a = dot(ray.direction, ray.direction);
    float b = 2.0 * dot(oc, ray.direction);
    float c = dot(oc, oc) - s.radius * s.radius;

    float d = b * b - 4.0 * a * c;

    if(d < 0.0)
        return InvalidIntersection;

    float r = sqrt(d);

    float t0 = (-b - r) / (2.0 * a);
    float t1 = (-b + r) / (2.0 * a);

    if(t0 > tMin && t0 < tMax)
        return t0;

    if(t1 > tMin && t1 < tMax)
        return t1;

    return InvalidIntersection;
}

void testSphere(
    const in source ray,
    const in sphere s,
    inout contact hit)
{
    float t =
        getSphereIntersection(
            ray,
            s,
            0.001,
            hit.intersection);

    if(t < hit.intersection)
    {
        hit.intersection = t;
        hit.object = s;
    }
}

contact createContact()
{
    contact hit;

    hit.intersection = InvalidIntersection;
    hit.object.position = vec3(0.0);
    hit.object.radius = 0.0;

    return hit;
}

vec3 getSphereAppearance(
    const in source ray,
    const in sphere s,
    const in float t)
{
    vec3 p = ray.position + t * ray.direction;

    vec3 n = normalize(p - s.position);

    vec3 view = normalize(ray.position - p);

    float light = max(0.0, 0.5 + 0.5 * dot(view, n));

    vec3 a = abs(n);

    float m = max(a.x, max(a.y, a.z));

    vec3 color = step(vec3(m), a);

    return light * color;
}

